APP_NAME=invoiceflow-api
ENVIRONMENT=development

POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://invoiceflow:replace-with-a-local-password@db:5432/invoiceflow

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:18000

# Optional post-commit n8n integration. n8n is not required for core workflows.
N8N_ENABLED=false
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=
N8N_SERVICE_NAME=n8n-aging-review-monitor
# Store only the SHA-256 verifier in the API environment; never place the raw
# token in the API configuration.
N8N_SERVICE_TOKEN_HASH=
# Inject the raw value only into the n8n runtime; generate with the backend
# token helper and never commit a real value.
INVOICEFLOW_N8N_SERVICE_TOKEN=
N8N_TIMEOUT_SECONDS=5
AGING_REVIEW_THRESHOLD_MINUTES=60

# OIDC authentication boundary (disabled until explicitly configured).
# Production startup remains blocked until PR-01C authorization enforcement.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:18000/api/v1/auth/callback
OIDC_SCOPES=openid profile email
OIDC_TIMEOUT_SECONDS=10
OIDC_TRANSACTION_COOKIE_SECRET=
AUTH_CSRF_SECRET=
AUTH_SESSION_COOKIE_NAME=invoiceflow_session
AUTH_TRANSACTION_COOKIE_NAME=invoiceflow_oidc_transaction
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_SESSION_ACTIVITY_UPDATE_SECONDS=300
AUTH_STATE_TTL_SECONDS=600
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:18000
AUTH_REQUIRE_ORIGIN=false
AUTH_PROTECTION_COMPLETE=false

# Private storage root for validated invoice PDFs.
# Relative paths resolve against the backend working directory; the Compose
# api service overrides this with an absolute path on a named volume.
INVOICE_STORAGE_PATH=storage

# Deterministic digital-text extraction baseline.
MAX_INVOICE_PAGES=50
MIN_EXTRACTED_TEXT_CHARS=50

# Structured invoice extraction (server-side only; never expose the API key to React).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MAX_LLM_INPUT_CHARS=20000
INVOICE_EXTRACTION_PROMPT_VERSION=invoice-extraction-v1
INVOICE_EXTRACTION_SCHEMA_VERSION=invoice-schema-v1
