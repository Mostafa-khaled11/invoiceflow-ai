APP_NAME=invoiceflow-api
ENVIRONMENT=development

POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://invoiceflow:replace-with-a-local-password@db:5432/invoiceflow

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# Private storage root for validated invoice PDFs.
# Relative paths resolve against the backend working directory; the Compose
# api service overrides this with an absolute path on a named volume.
INVOICE_STORAGE_PATH=storage

# Deterministic digital-text extraction baseline.
MAX_INVOICE_PAGES=50
MIN_EXTRACTED_TEXT_CHARS=50

# Structured invoice extraction (server-side only; never expose the API key to React).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
MAX_LLM_INPUT_CHARS=20000
INVOICE_EXTRACTION_PROMPT_VERSION=invoice-extraction-v1
INVOICE_EXTRACTION_SCHEMA_VERSION=invoice-schema-v1
